# Copy to .env.local for development. NEVER commit real values.
# Production secrets live in the hosting platform, not in this repo.

# Public base URL used to build share links
APP_URL=http://localhost:3000

# PostgreSQL connection string (local dev database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/valentino_dev

# Server-side secret used to hash edit secrets. Generate: openssl rand -base64 32
EDIT_SECRET_PEPPER=replace-me-with-a-random-value

# Media (used from milestone M3)
MEDIA_STORAGE_DRIVER=local
STORAGE_PROVIDER=local
MEDIA_LOCAL_DIR=storage/media
MEDIA_MAX_BYTES=5242880
MEDIA_MAX_PIXELS=25000000

# Cloudinary (production media storage)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Alternatively:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
