generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExperienceStatus {
  DRAFT
  PUBLISHED
  DISABLED
  DELETED
}

model Experience {
  id                     String           @id @default(cuid())
  publicId               String           @unique
  editCredentialHash     String
  editCredentialVersion  Int              @default(1)
  editCredentialIssuedAt DateTime         @default(now())
  
  templateId             String
  templateVersion        String
  
  draftConfig            String
  draftRevision          Int              @default(1)
  
  publishedConfig        String?
  publishedRevision      Int?
  publishedAt            DateTime?
  scheduledUnlockAt      DateTime?
  
  status                 ExperienceStatus @default(DRAFT)
  
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  media                  ExperienceMedia[]
  reactions              ExperienceReaction[]
  replies                ExperienceReply[]
  reports                ExperienceReport[]

  @@index([publicId])
  @@index([status])
  @@index([scheduledUnlockAt])
}

enum MediaType {
  PHOTO
  AUDIO
  VIDEO
}

enum MediaStatus {
  DRAFT
  PUBLISHED
  ORPHANED
  DELETED
}

model ExperienceMedia {
  id           String      @id @default(cuid())
  experienceId String
  experience   Experience  @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  mediaType    MediaType
  filename     String
  storageKey   String      @unique
  mimeType     String
  sizeBytes    Int

  caption      String?
  altText      String?
  displayOrder Int         @default(0)
  status       MediaStatus @default(DRAFT)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([experienceId])
  @@index([storageKey])
}

model ExperienceReaction {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  reaction     String
  note         String?
  createdAt    DateTime   @default(now())

  @@index([experienceId])
}

model ExperienceReply {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  senderName   String?
  content      String
  createdAt    DateTime   @default(now())

  @@index([experienceId])
}

model ExperienceReport {
  id           String     @id @default(cuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  reason       String
  details      String?
  reporterHash String
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())

  @@index([experienceId])
  @@index([status])
}
